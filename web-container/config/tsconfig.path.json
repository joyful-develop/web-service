{
  "compilerOptions": {
    "paths": {
      "@/*": ["../src/*"],
      "@app/*": ["../src/app/*"],
      "@entities/*": ["../src/entities/*"],
      "@features/*": ["../src/features/*"],
      "@lib/*": ["../src/lib/*"],
      "@pages/*": ["../src/pages/*"],
      "@sharded/*": ["../src/sharded/*"],
      "@widgets/*": ["../src/widgets/*"]
    }
  },
  "include": ["../src"]
}
