{
  "js/ts.tsdk.path": "node_modules\\typescript\\lib",

  "debug.javascript.terminalOptions": {
    "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**", "**/node_modules/.vite-temp/**"]
  },
  "tailwindCSS.suggestions": true,
  "tailwindCSS.experimental.configFile": "./src/app/styles/global.css",

  "js/ts.suggest.autoImports": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "js/ts.preferences.includePackageJsonAutoImports": "auto",

  "js/ts.updateImportsOnFileMove.enabled": "always",

  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore"
}
